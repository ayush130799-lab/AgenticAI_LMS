# --- Database ---
DATABASE_URL=postgresql+psycopg://lms_user:lms_password@localhost:5432/agentic_ai_lms
# Sync URL used by Alembic
DATABASE_URL_SYNC=postgresql+psycopg://lms_user:lms_password@localhost:5432/agentic_ai_lms

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AI / LLM ---
# Provider: "groq" (free at console.groq.com) or "anthropic" (paid)
LLM_PROVIDER=groq
# Paste your key right after the '=' with nothing else on the line (no trailing comment).
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Alternative: Anthropic
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# Embeddings — Groq has no embedding API. Leave blank to use the built-in
# deterministic hashing fallback (works offline, good enough for local dev).
# For production-quality embeddings, set a Voyage AI key (voyageai.com).
EMBEDDING_PROVIDER=anthropic
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3

# --- Vector DB ---
# pgvector runs inside the same Postgres instance (DATABASE_URL above).
VECTOR_DATABASE_URL=postgresql+psycopg://lms_user:lms_password@localhost:5432/agentic_ai_lms

# --- App ---
ENV=development
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000

# --- Rate limiting (per client IP, slowapi syntax) ---
# The limits are keyed on the client IP: behind a reverse proxy run uvicorn with --proxy-headers so the real
# client address is used, otherwise every user shares the proxy's address and its budget.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
# Login and register only (brute-force protection). Kept generous enough for a classroom behind one NAT address.
RATE_LIMIT_AUTH=20/minute

# --- Seeding ---
# Optional: pins the default admin account the seed script creates.
# If unset, defaults to admin@agenticailms.dev / AdminPass123! — change this
# in any shared/deployed environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# --- Code execution sandbox (coding questions in module assessments) ---
# Shared secret between the backend and the isolated code_runner service. Set your own long random value.
CODE_RUNNER_TOKEN=dev-runner-token-change-me
